# Copy this file to .env for local development. Never commit .env.

# Postgres connection string. Local example (create the database first: createdb parer):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/parer

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional. Turns the job assistant from keyword matching into real AI (Claude).
# Email for password reset. Use ONE provider (Brevo or Resend). Without one, reset links print in the server console in development.
# BREVO_API_KEY=
# RESEND_API_KEY=
# EMAIL_FROM=Parer <hello@yourdomain.com>
# Public address of your site, used in email links (Render sets RENDER_EXTERNAL_URL automatically).
# APP_URL=https://your-app.onrender.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Optional. Server port (default 3000).
# PORT=3000
